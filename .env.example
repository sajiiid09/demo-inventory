# MicroLoan Demo — local environment variables
# Copy to .env and adjust as needed. Never commit the real .env.

# The Postgres installed on this machine, on the standard port. The `microloan`
# database sits alongside whatever else is already on that server.
# (Docker Compose is the alternative: it runs its own Postgres on 5433 so the two
# never collide, and its api service overrides this to reach `postgres` directly.)
DATABASE_URL=postgresql+psycopg://microloan:123@localhost:5432/microloan

# JWT signing secret for the demo. Change for anything beyond localhost.
JWT_SECRET=dev-only-secret-please-change-me-32-bytes

# Frontend origin allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:3000
