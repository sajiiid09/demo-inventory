# MicroLoan Demo — local environment variables
# Copy to .env and adjust as needed. Never commit the real .env.

# Native development (host machine): Postgres container exposed on localhost:5433
# (5432 is left free for any local Postgres you already run).
# Inside docker compose the api service overrides this to reach `postgres`.
DATABASE_URL=postgresql+psycopg://microloan:microloan@localhost:5433/microloan

# JWT signing secret for the demo. Change for anything beyond localhost.
JWT_SECRET=dev-secret-change-me

# Frontend origin allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:3000
